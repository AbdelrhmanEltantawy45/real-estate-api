// =============================================================================
// Real Estate Backend - Prisma Schema
// Database: PostgreSQL
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum UserRole {
  USER
  AGENT
  ADMIN
}

enum ListingType {
  SALE
  RENT
}

enum PropertyStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  REJECTED
  SOLD
  RENTED
  ARCHIVED
}

enum AgentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum InquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
}

enum NotificationType {
  INQUIRY
  APPOINTMENT
  PROPERTY
  AGENT
  ACCOUNT
  SYSTEM
  REVIEW
}

// -----------------------------------------------------------------------------
// User & Authentication
// -----------------------------------------------------------------------------

model User {
  id             String   @id @default(uuid())
  fullName       String   @map("full_name")
  email          String   @unique
  passwordHash   String   @map("password_hash")
  phone          String?
  avatarUrl      String?  @map("avatar_url")
  role           UserRole @default(USER)
  isActive       Boolean  @default(true) @map("is_active")
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  agentProfile           AgentProfile?
  favorites              Favorite[]
  appointments           Appointment[]
  inquiries              Inquiry[]
  notifications          Notification[]
  reviews                Review[]
  propertyViews          PropertyView[]
  passwordResetTokens    PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  refreshTokens          RefreshToken[]
  auditLogs              AuditLog[] @relation("AuditActor")

  @@index([role])
  @@index([isActive])
  @@map("users")
}

model AgentProfile {
  id                 String                   @id @default(uuid())
  userId             String                   @unique @map("user_id")
  agencyName         String?                  @map("agency_name")
  bio                String?                  @db.Text
  specialties        String[]
  licenseNumber      String?                   @map("license_number")
  verificationStatus  AgentVerificationStatus  @default(PENDING) @map("verification_status")
  verifiedAt         DateTime?                 @map("verified_at")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  properties   Property[]
  appointments Appointment[]
  inquiries    Inquiry[]
  reviews      Review[]

  @@index([verificationStatus])
  @@map("agent_profiles")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

// -----------------------------------------------------------------------------
// Properties
// -----------------------------------------------------------------------------

model Property {
  id              String         @id @default(uuid())
  title           String
  slug            String         @unique
  description     String         @db.Text
  listingType     ListingType    @map("listing_type")
  propertyType    String         @map("property_type")
  price           Decimal        @db.Decimal(14, 2)
  currency        String         @default("SAR")
  area            Decimal        @db.Decimal(10, 2)
  bedrooms        Int            @default(0)
  bathrooms       Int            @default(0)
  parkingSpaces   Int            @default(0) @map("parking_spaces")
  city            String
  neighborhood    String?
  address         String?
  latitude        Decimal?       @db.Decimal(9, 6)
  longitude       Decimal?       @db.Decimal(9, 6)
  status          PropertyStatus @default(DRAFT)
  rejectionReason String?        @map("rejection_reason") @db.Text
  isFeatured      Boolean        @default(false) @map("is_featured")
  publishedAt     DateTime?      @map("published_at")
  agentId         String         @map("agent_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  deletedAt       DateTime?      @map("deleted_at")

  agent       AgentProfile   @relation(fields: [agentId], references: [id])
  images      PropertyImage[]
  amenities   Amenity[]      @relation("PropertyAmenities")
  favorites   Favorite[]
  appointments Appointment[]
  inquiries   Inquiry[]
  views       PropertyView[]

  @@index([status])
  @@index([listingType])
  @@index([propertyType])
  @@index([city])
  @@index([neighborhood])
  @@index([isFeatured])
  @@index([createdAt])
  @@index([price])
  @@index([agentId])
  @@index([deletedAt])
  @@index([status, listingType, city])
  @@map("properties")
}

model PropertyImage {
  id          String   @id @default(uuid())
  propertyId  String   @map("property_id")
  imageUrl    String   @map("image_url")
  storageKey  String   @map("storage_key")
  altText     String?  @map("alt_text")
  displayOrder Int     @default(0) @map("display_order")
  isPrimary   Boolean  @default(false) @map("is_primary")
  createdAt   DateTime @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_images")
}

model Amenity {
  id       String  @id @default(uuid())
  name     String  @unique
  slug     String  @unique
  category String  @default("General")
  properties Property[] @relation("PropertyAmenities")

  @@index([category])
  @@map("amenities")
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  propertyId String   @map("property_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([propertyId])
  @@map("favorites")
}

// -----------------------------------------------------------------------------
// Appointments, Inquiries, Notifications, Reviews, Analytics
// -----------------------------------------------------------------------------

model Appointment {
  id                String            @id @default(uuid())
  userId            String            @map("user_id")
  agentId           String            @map("agent_id")
  propertyId        String            @map("property_id")
  scheduledAt       DateTime          @map("scheduled_at")
  status            AppointmentStatus @default(PENDING)
  message           String?           @db.Text
  cancellationReason String?           @map("cancellation_reason") @db.Text
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  user     User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  agent    AgentProfile @relation(fields: [agentId], references: [id])
  property Property     @relation(fields: [propertyId], references: [id])

  @@index([userId])
  @@index([agentId])
  @@index([propertyId])
  @@index([status])
  @@index([scheduledAt])
  @@map("appointments")
}

model Inquiry {
  id         String        @id @default(uuid())
  userId     String?       @map("user_id")
  agentId    String        @map("agent_id")
  propertyId String        @map("property_id")
  name       String
  email      String
  phone      String?
  message    String        @db.Text
  status      InquiryStatus @default(NEW)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  user     User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  agent    AgentProfile   @relation(fields: [agentId], references: [id])
  property Property       @relation(fields: [propertyId], references: [id])

  @@index([agentId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("inquiries")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  title     String
  message   String           @db.Text
  type      NotificationType
  isRead    Boolean           @default(false) @map("is_read")
  metadata  Json?
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model Review {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  agentId   String   @map("agent_id")
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  agent AgentProfile   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([userId, agentId])
  @@index([agentId])
  @@map("reviews")
}

model PropertyView {
  id         String    @id @default(uuid())
  propertyId String    @map("property_id")
  userId     String?   @map("user_id")
  sessionId  String?   @map("session_id")
  createdAt  DateTime  @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([propertyId, createdAt])
  @@index([userId])
  @@map("property_views")
}

// -----------------------------------------------------------------------------
// Audit Log
// -----------------------------------------------------------------------------

model AuditLog {
  id         String    @id @default(uuid())
  actorUserId String?   @map("actor_user_id")
  action     String
  targetType String?    @map("target_type")
  targetId   String?    @map("target_id")
  metadata   Json?
  ipAddress  String?   @map("ip_address")
  createdAt  DateTime  @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}
