# =============================================================================
# Real Estate Backend - Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in real values. NEVER commit the real .env.
# Generate strong secrets, e.g. with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# ---- Application ----
NODE_ENV=development
PORT=3001
APP_NAME=Real Estate API
# Comma-separated list of allowed CORS origins (your frontend URLs)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Set to 'true' to expose Swagger docs (disable in production or keep behind auth)
ENABLE_SWAGGER=true

# ---- Database (PostgreSQL) ----
# These must match the docker-compose values when using `docker compose up`.
POSTGRES_USER=realestate
POSTGRES_PASSWORD=realestate_password
POSTGRES_DB=realestate
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Prisma connection string. The individual POSTGRES_* vars above are used by
# docker-compose; this URL is what Prisma uses directly.
DATABASE_URL=postgresql://realestate:realestate_password@localhost:5432/realestate?schema=public

# ---- JWT / Auth ----
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Auth token delivery: 'true' = httpOnly cookies, 'false' = tokens returned in JSON body
AUTH_COOKIE_ENABLED=true
# Cookie security
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
# When true, the server sets the refresh-token cookie path to /api/v1/auth for tighter scoping
COOKIE_PATH_SCOPED=true

# ---- Password reset ----
PASSWORD_RESET_TOKEN_EXPIRES_HOURS=1
# Public app URL used to build the reset-password link sent to users
APP_PUBLIC_URL=http://localhost:3000

# ---- File uploads / storage ----
# Storage driver: 'local' | 's3' | 'cloudinary'
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=uploads
# Base URL where locally uploaded files are publicly served
PUBLIC_BASE_URL=http://localhost:3001
# Max upload size in bytes (default 5MB)
MAX_UPLOAD_SIZE_BYTES=5242880
# AWS S3 (when STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Cloudinary (when STORAGE_DRIVER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Rate limiting ----
# Global throttle defaults
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100
# Stricter limits for auth/password endpoints (per AUTH_RATE_LIMIT_TTL seconds)
AUTH_RATE_LIMIT_TTL=900
AUTH_RATE_LIMIT_LIMIT=10
